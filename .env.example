# ---------------------------------------------------------------------------
# PalPatrol / Little Rest — example environment file
#
# NOTHING IN THE SITE READS THIS FILE TODAY.
# The site is currently 100% static (index.html + app.js + CSS) and stores every
# answer in the visitor's own browser via localStorage. There is no server, no
# build step, and no network call anywhere in app.js.
#
# This file exists so that IF you decide to add Supabase (see DEVELOPER-NOTES.md),
# you already know exactly which values you need to obtain. Copy it to `.env`,
# fill in the real values from your own Supabase dashboard, and never commit `.env`.
#
# DO NOT paste real keys into this file — it is meant to be committed with
# placeholders only.
# ---------------------------------------------------------------------------

# Supabase project URL. Found at: Supabase dashboard > Project Settings > API.
# Looks like: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase "anon" / publishable key. Also under Project Settings > API.
# This one is SAFE to ship in front-end code, but ONLY when Row Level Security
# is switched on for the table and the policy allows insert-only (see notes).
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Supabase "service_role" key.
# NEVER put this in front-end code, in this repo, or in any file the browser can
# download. It bypasses Row Level Security completely. Keep it in your own
# machine's environment only, for server-side scripts or one-off exports.
SUPABASE_SERVICE_ROLE_KEY=KEEP-THIS-SECRET-NEVER-COMMIT

# Table that the "Maybe Try This?" answers would be written to.
SUPABASE_ANSWERS_TABLE=maybe_try_this_answers
